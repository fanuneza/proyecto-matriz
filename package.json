{
  "name": "matriz-scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run generate-artifacts",
    "build": "next build && node scripts/inline-critical-css.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate-artifacts": "tsx scripts/generate-data-artifacts.ts",
    "check-output": "tsx scripts/check-output.ts",
    "check-routes": "tsx scripts/check-static-routes.ts",
    "check-seo": "tsx scripts/check-seo-output.ts",
    "write-snapshot": "tsx scripts/write-monthly-snapshot.ts",
    "analyze": "npm run generate-artifacts && set ANALYZE=true&& next build --webpack"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead",
    "not ie 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@next/bundle-analyzer": "16.4.6",
    "@playwright/test": "^1.65.1",
    "@types/node": "26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "critters": "^0.0.25",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "glob": "^14.0.6",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.2"
  }
}
